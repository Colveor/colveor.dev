# Read-only token for fetching package docs (doc/*.md) from the private
# Colveor/colveor_ui and Colveor/colveor_flutter repos at build time.
# Fine-grained PAT with Contents: read on those two repos.
COLVEOR_DOCS_TOKEN=

# Optional, for local previews: read package docs from local checkouts
# instead of GitHub. Comma-separated <source id>=<path to repo>.
# COLVEOR_DOCS_LOCAL=colveor_ui=../../flutter/colveor_ui,colveor_flutter=../../flutter/colveor_flutter
